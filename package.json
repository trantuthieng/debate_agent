{
  "name": "local-multi-agent-coder",
  "displayName": "Local Multi-Agent Coder",
  "description": "Create software projects using multiple local LLM agents through Ollama. Sequential multi-agent workflow with file-based agent communication.",
  "version": "1.0.1",
  "publisher": "local-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "ollama",
    "llm",
    "ai",
    "agents",
    "code generation"
  ],
  "activationEvents": [
    "onView:localMultiAgentCoder.sidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "localMultiAgentCoder.openPanel",
        "title": "Local Multi-Agent Coder: Open Panel",
        "category": "Local Multi-Agent Coder"
      },
      {
        "command": "localMultiAgentCoder.startNewProject",
        "title": "Local Multi-Agent Coder: Start New Project",
        "category": "Local Multi-Agent Coder"
      },
      {
        "command": "localMultiAgentCoder.designAgentTeam",
        "title": "Local Multi-Agent Coder: Design Agent Team (Agent-Creates-Agents)",
        "category": "Local Multi-Agent Coder"
      },
      {
        "command": "localMultiAgentCoder.runAutonomousGoal",
        "title": "Local Multi-Agent Coder: Autonomous Goal (Design → Debate → Build)",
        "category": "Local Multi-Agent Coder"
      },
      {
        "command": "localMultiAgentCoder.resumeWorkflow",
        "title": "Local Multi-Agent Coder: Resume Workflow",
        "category": "Local Multi-Agent Coder"
      },
      {
        "command": "localMultiAgentCoder.stopWorkflow",
        "title": "Local Multi-Agent Coder: Stop Workflow",
        "category": "Local Multi-Agent Coder"
      },
      {
        "command": "localMultiAgentCoder.showAgentNotes",
        "title": "Local Multi-Agent Coder: Show Agent Notes",
        "category": "Local Multi-Agent Coder"
      },
      {
        "command": "localMultiAgentCoder.openSettingsFile",
        "title": "Local Multi-Agent Coder: Open Settings File",
        "category": "Local Multi-Agent Coder"
      },
      {
        "command": "localMultiAgentCoder.configureYouTube",
        "title": "Local Multi-Agent Coder: Configure YouTube Connector",
        "category": "Local Multi-Agent Coder"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localMultiAgentCoder",
          "title": "Local Multi-Agent Coder",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "localMultiAgentCoder": [
        {
          "type": "webview",
          "id": "localMultiAgentCoder.sidebar",
          "name": "Agent Coder"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test test/*.test.js test/unit/*.test.js",
    "test:vscode": "node test/vscode/runTest.js",
    "test:e2e:ollama": "node test/e2e_run.js",
    "test:e2e:brick-breaker": "npm run compile && node test/brick_breaker_e2e.js",
    "test:e2e:brick-breaker:local": "bash scripts/run-on-internal-disk.sh node test/brick_breaker_e2e.js",
    "test:e2e:word-addin": "npm run compile && node test/word_addin_e2e.js",
    "test:e2e:build:ollama": "node test/e2e_run.js --build-only",
    "resume:auto": "npm run compile && node scripts/run-with-auto-resume.js",
    "check": "npm run compile && npm run lint && npm test",
    "check:release": "npm run check && npm run test:vscode",
    "prepackage:vsix": "npm run check:release",
    "package:vsix": "vsce package --allow-missing-repository --out dist/local-multi-agent-coder-1.0.1.vsix",
    "postpackage:vsix": "npm run test:vsix",
    "test:vsix": "node test/vscode/installVsix.js",
    "lint": "eslint src",
    "server": "npm run compile && node out/server/index.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.4.0",
    "typescript": "^5.3.3"
  }
}
