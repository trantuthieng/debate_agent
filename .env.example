# Copy this file to .env (gitignored) and fill in your own values.
# Never commit a real auth key.

# Generate at https://login.tailscale.com/admin/settings/keys
# (tip: an ephemeral, reusable key with a tag works well for this)
TS_AUTHKEY=tskey-client-xxxxxxxxxxxx

# Only needed if Ollama runs somewhere other than the Docker host's default
# gateway — leave unset to use http://host.docker.internal:11434.
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional: pushes every autonomous-build phase change and failure to a
# Telegram chat so the boss can follow a run from their phone. Leave both
# unset to skip Telegram entirely — it is never required to run a build.
# 1. Message @BotFather on Telegram, /newbot, copy the token it gives you.
# 2. Message your new bot once (anything), then open in a browser:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    and copy the "chat":{"id": ...} value (or use @userinfobot for your own id).
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID=123456789
